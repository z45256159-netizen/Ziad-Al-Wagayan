# ---------------------------------------------------------------------------
# Alpaca API credentials
# ---------------------------------------------------------------------------
# 1. Copy this file to `.env`:   cp .env.example .env
# 2. Fill in your keys from https://app.alpaca.markets/ (Paper account first!)
# 3. NEVER commit your real .env file (it is git-ignored for you).
# ---------------------------------------------------------------------------

# Your Alpaca API key ID and secret key.
# For PAPER trading, generate these from the "Paper Trading" section of the
# Alpaca dashboard. For LIVE trading you need keys from a funded live account.
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# ---------------------------------------------------------------------------
# Trading mode
# ---------------------------------------------------------------------------
# LIVE=false  -> PAPER trading (fake money, paper-api.alpaca.markets)  [DEFAULT]
# LIVE=true   -> LIVE trading  (REAL money, api.alpaca.markets)
# Leave this as false until you have tested thoroughly in paper mode.
LIVE=false

# ---------------------------------------------------------------------------
# Position sizing & risk
# ---------------------------------------------------------------------------
# Fraction of buying power to allocate per position (0.05 = 5%).
POSITION_SIZE_PCT=0.05

# Hard ceiling on the dollar value of any single order.
MAX_ORDER_DOLLARS=1000

# ---------------------------------------------------------------------------
# Scanner tuning (see strategy.py for what these do)
# ---------------------------------------------------------------------------
# How many daily bars to pull. Needs to cover the 50-day SMA plus MACD/RSI
# warmup, so keep this at 60 or more.
LOOKBACK_DAYS=60
