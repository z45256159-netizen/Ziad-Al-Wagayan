# Copy this to `.streamlit/secrets.toml` for LOCAL runs, OR paste these lines
# into the "Secrets" box when deploying to Streamlit Community Cloud.
# The real secrets.toml is git-ignored — never commit your keys.

ALPACA_API_KEY = "PK...your paper key..."
ALPACA_API_SECRET = "...your paper secret..."

# "false" = paper (fake money, default) · "true" = LIVE real money
LIVE = "false"

# OPTIONAL — turns on the "AI picks the trade" feature, for FREE.
# Get a free key (no credit card) from https://console.groq.com and paste it
# here. Leave blank to run the rule-based scanner without AI.
# GROQ_API_KEY = "gsk_..."
#
# Alternative free provider (used only if GROQ_API_KEY is not set):
# OPENROUTER_API_KEY = "sk-or-..."

# Optional risk tuning
POSITION_SIZE_PCT = "0.05"
MAX_ORDER_DOLLARS = "1000"
LOOKBACK_DAYS = "20"
